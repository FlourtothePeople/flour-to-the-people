# Copy to .env.handoff and fill in. .env.handoff is ignored by git.
# Every script in scripts/ reads this file. Leave a value empty to let the
# script ask for it or skip the step that needs it.

# --- GitHub ---
GITHUB_OWNER=                 # the new owner's GitHub username or organization
GITHUB_REPO=flour-to-the-people
GITHUB_VISIBILITY=public      # public or private

# --- Cloudflare ---
CF_PAGES_PROJECT=flour-to-the-people
D1_NAME=flour-to-the-people-orders
CLOUDFLARE_ACCOUNT_ID=        # find it with: npx wrangler whoami
CF_API_TOKEN=                 # token with Account > Cloudflare Pages > Edit. Stored as the GitHub secret CLOUDFLARE_API_TOKEN and used for the custom-domain API call.
CF_WRANGLER_API_TOKEN=        # OPTIONAL. Token with Pages Edit + D1 Edit, for machines with no browser. Leave empty when you ran: npx wrangler login

# --- Stripe (start with TEST keys; switch to live only after scripts/06-smoke-test.sh passes) ---
STRIPE_SECRET_KEY=            # sk_test_... then sk_live_...
STRIPE_PUBLISHABLE_KEY=       # pk_test_... then pk_live_...
STRIPE_WEBHOOK_SECRET=        # whsec_... ; scripts/03-stripe.sh fills this in when it creates the endpoint
STRIPE_TAX_ENABLED=false      # the checkout code does not compute tax yet; see docs/KNOWN-ISSUES.md

# --- Domain ---
DOMAIN=flourtothepeople.org
